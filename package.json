{
  "name": "studybuddy",
  "version": "2.2.0",
  "private": true,
  "description": "StudyBuddy Pro — Netlify Functions (Neon backend)",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@neondatabase/neon-js": "0.7.0-beta",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "vitest": "4.1.11"
  },
  "scripts": {
    "test": "npm run test:legacy && npm run test:unit && npm run test:db",
    "test:legacy": "node tests/run_tests.js",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "lint": "npm run lint:format && npm run lint:syntax && npm run lint:version",
    "lint:format": "prettier --check .",
    "lint:syntax": "node scripts/check-syntax.mjs app.html index.html sw.js js/sync-merge.js netlify/functions scripts tests",
    "lint:version": "node scripts/check-version.mjs",
    "format": "prettier --write .",
    "build:neon": "esbuild scripts/neon-bundle/entry.mjs --bundle --format=esm --platform=browser --target=es2020 --minify --legal-comments=none --alias:@neondatabase/auth/react/adapters=./scripts/neon-bundle/empty.mjs --outfile=js/vendor/neon-js.bundle.js"
  }
}
